{
  "openapi": "3.1.1",
  "info": {
    "title": "Commercial Platform API",
    "description": "Commercial Platform HTTP contract: system, diagnostics, the standard error envelope and active-context selection.",
    "version": "v1"
  },
  "paths": {
    "/api/v1/system/version": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Service name, version and environment.",
        "operationId": "GetVersion",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/system/me": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "The server-side execution scope of the caller (identity-only when no business scope is active).",
        "operationId": "GetCurrentScope",
        "parameters": [
          {
            "name": "X-Active-Company-Id",
            "in": "header",
            "description": "Selection hint (not authority): the company to act in. Validated against the caller's memberships; a company the caller may not use is ACTIVE_COMPANY_FORBIDDEN.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Active-Customer-Binding-Id",
            "in": "header",
            "description": "Selection hint (not authority): the caller's own customer binding to act under. Required when the caller has several active bindings (ACTIVE_CUSTOMER_BINDING_REQUIRED).",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentScopeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/system/access-probe/workforce": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Authorization-policy probe: WORKFORCE identities only (401 vs 403 contract).",
        "operationId": "ProbeWorkforceAccess",
        "parameters": [
          {
            "name": "X-Active-Company-Id",
            "in": "header",
            "description": "Selection hint (not authority): the company to act in. Validated against the caller's memberships; a company the caller may not use is ACTIVE_COMPANY_FORBIDDEN.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Active-Customer-Binding-Id",
            "in": "header",
            "description": "Selection hint (not authority): the caller's own customer binding to act under. Required when the caller has several active bindings (ACTIVE_CUSTOMER_BINDING_REQUIRED).",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessProbeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/system/access-probe/customer": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Authorization-policy probe: CUSTOMER identities with exactly one resolved active customer binding.",
        "operationId": "ProbeCustomerAccess",
        "parameters": [
          {
            "name": "X-Active-Company-Id",
            "in": "header",
            "description": "Selection hint (not authority): the company to act in. Validated against the caller's memberships; a company the caller may not use is ACTIVE_COMPANY_FORBIDDEN.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Active-Customer-Binding-Id",
            "in": "header",
            "description": "Selection hint (not authority): the caller's own customer binding to act under. Required when the caller has several active bindings (ACTIVE_CUSTOMER_BINDING_REQUIRED).",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessProbeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/system/access-probe/active-company": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Authorization-policy probe: requires exactly one active company (ACTIVE_COMPANY_REQUIRED contract).",
        "operationId": "ProbeActiveCompanyScope",
        "parameters": [
          {
            "name": "X-Active-Company-Id",
            "in": "header",
            "description": "Selection hint (not authority): the company to act in. Validated against the caller's memberships; a company the caller may not use is ACTIVE_COMPANY_FORBIDDEN.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Active-Customer-Binding-Id",
            "in": "header",
            "description": "Selection hint (not authority): the caller's own customer binding to act under. Required when the caller has several active bindings (ACTIVE_CUSTOMER_BINDING_REQUIRED).",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessProbeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/system/access-probe/customer-users-manage": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Authorization-policy probe: binding-scoped permission customer.users.manage of the ACTIVE binding.",
        "operationId": "ProbeCustomerUsersManage",
        "parameters": [
          {
            "name": "X-Active-Company-Id",
            "in": "header",
            "description": "Selection hint (not authority): the company to act in. Validated against the caller's memberships; a company the caller may not use is ACTIVE_COMPANY_FORBIDDEN.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Active-Customer-Binding-Id",
            "in": "header",
            "description": "Selection hint (not authority): the caller's own customer binding to act under. Required when the caller has several active bindings (ACTIVE_CUSTOMER_BINDING_REQUIRED).",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessProbeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/diagnostics/outbox-pings": {
      "post": {
        "tags": [
          "Diagnostics"
        ],
        "summary": "Writes a diagnostic outbox message in an application transaction (dispatched by the Worker).",
        "operationId": "CreateOutboxPing",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/CreateOutboxPingRequest"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiagnosticPingAccepted"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/diagnostics/outbox-pings/{messageId}": {
      "get": {
        "tags": [
          "Diagnostics"
        ],
        "summary": "Dispatch status of a diagnostic outbox message.",
        "operationId": "GetOutboxPing",
        "parameters": [
          {
            "name": "messageId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiagnosticPingStatus"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccessProbeResponse": {
        "required": [
          "granted",
          "principalType"
        ],
        "type": "object",
        "properties": {
          "granted": {
            "type": "boolean"
          },
          "principalType": {
            "type": "string"
          }
        }
      },
      "CreateOutboxPingRequest": {
        "required": [
          "note"
        ],
        "type": "object",
        "properties": {
          "note": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CurrentScopeResponse": {
        "required": [
          "principalType",
          "scopeKind",
          "principalId",
          "tenantId",
          "activeCompanyId",
          "customerAccountId",
          "activeCustomerBindingId",
          "permissions",
          "scopeFingerprint",
          "pendingSelection",
          "correlationId"
        ],
        "type": "object",
        "properties": {
          "principalType": {
            "type": "string"
          },
          "scopeKind": {
            "type": "string"
          },
          "principalId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "tenantId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "activeCompanyId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "customerAccountId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "activeCustomerBindingId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scopeFingerprint": {
            "type": "string"
          },
          "pendingSelection": {
            "type": [
              "null",
              "string"
            ]
          },
          "correlationId": {
            "type": "string"
          }
        }
      },
      "DiagnosticPingAccepted": {
        "required": [
          "messageId",
          "correlationId"
        ],
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "format": "uuid"
          },
          "correlationId": {
            "type": "string"
          }
        }
      },
      "DiagnosticPingStatus": {
        "required": [
          "messageId",
          "outboxStatus",
          "attempts",
          "processedAtUtc",
          "handlerEffectRecorded",
          "correlationId"
        ],
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "format": "uuid"
          },
          "outboxStatus": {
            "type": "string"
          },
          "attempts": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "processedAtUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "handlerEffectRecorded": {
            "type": "boolean"
          },
          "correlationId": {
            "type": "string"
          }
        }
      },
      "ErrorEnvelope": {
        "required": [
          "type",
          "title",
          "status",
          "code",
          "detail",
          "instance",
          "correlationId",
          "traceId",
          "errors"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "code": {
            "type": "string"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "correlationId": {
            "type": "string"
          },
          "traceId": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "VersionResponse": {
        "required": [
          "service",
          "version",
          "environment",
          "runtime"
        ],
        "type": "object",
        "properties": {
          "service": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          },
          "runtime": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "System"
    },
    {
      "name": "Diagnostics"
    }
  ]
}
