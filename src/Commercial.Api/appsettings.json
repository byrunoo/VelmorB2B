{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Commercial": "",
    "Redis": ""
  },
  "Commercial": {
    "Postgres": {
      "Host": "",
      "Port": "",
      "Database": "",
      "Runtime": { "Username": "", "Password": "" }
    }
  },
  "Hangfire": { "PrepareSchemaIfNecessary": false },
  "OpenApi": { "Enabled": false },
  "Diagnostics": { "EnableEndpoints": false },
  "Authentication": { "Development": { "Enabled": false } },
  "Database": { "ApplyMigrationsOnStartup": false }
}
