# Copy to .env.local for overrides. Never put secrets in VITE_* variables (they ship to the browser).
# Commercial API base URL as seen by the browser. Empty = same origin (Vite dev proxy / reverse proxy).
VITE_API_BASE_URL=
# Dev-server proxy target for /api and /health (node-side only).
VITE_API_PROXY_TARGET=http://localhost:5080
# Shown in the shell badge: development | test | staging | production
VITE_APP_ENV=development
